# Largest accepted upload, in MB
MAX_UPLOAD_MB=10
MAX_ROWS=200000
MAX_COLUMNS=200
# Uploaded and cleaned files are deleted after this many minutes
DATASET_TTL_MINUTES=60
MAX_DATASETS=50
# Where temporary files live (default: system temp dir / datasift)
# UPLOAD_DIR=
CORS_ORIGINS=http://localhost:3000
